{
  "name": "lace-trial",
  "version": "0.1.0",
  "private": true,
  "description": "Rough two-player trial of the lace world: the Pin and the Bobbin.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit && tsc -p worker",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/e2e/two-players.mjs",
    "build:cloudflare": "node tools/build.mjs --relay",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy": "npm run build:cloudflare && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  }
}
